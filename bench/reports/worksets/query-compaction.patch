+    if (capacity > 0u) {
+        slots_sort(world->query_slots, matches);
+        const uint32_t written = matches < capacity ? matches : capacity;
+        for (uint32_t i = 0u; i < written; ++i) {
+            bodies[i] = body_handle(world, world->query_slots[i]);
+        }
     }
