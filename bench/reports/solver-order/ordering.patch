+/* Isolated solver experiment; never included by the production source tree. */
+#ifndef SILK_STUDY_GRAPH_H
+#define SILK_STUDY_GRAPH_H
+
+#define STUDY_ZERO_GRAVITY 1u
+#define STUDY_JOINT 2u
+#define STUDY_KINEMATIC 4u
+#define STUDY_EQUAL_HEIGHT 8u
+#define STUDY_UNROOTED 16u
+#define STUDY_CYCLE 32u
+
+typedef struct study_context {
+    uint32_t *heads;
+    uint32_t *indegrees;
+    uint32_t *layers;
+    uint32_t *queue; /* After traversal: per-island fallback mask. */
+    uint32_t *next;  /* After traversal: per-contact layer sort key. */
+    uint32_t *order;
+    uint64_t graph_body_visits;
+    uint64_t graph_contact_visits;
+    uint64_t constraint_evaluations;
+    uint64_t ordered_island_steps;
+    uint64_t fallback_island_steps[6];
+} study_context;
+
+static size_t study_align(size_t size)
+{
+    return (size + 7u) & ~(size_t)7u;
+}
+
+static size_t study_memory_bytes(uint32_t bodies, uint32_t contacts)
+{
+    return study_align(sizeof(study_context)) +
+           4u * study_align((size_t)bodies * sizeof(uint32_t)) +
+           2u * study_align((size_t)contacts * sizeof(uint32_t));
+}
+
+static study_context *study_get(const sl_world_state *world)
+{
+    return (study_context *)((unsigned char *)world->contact_constraints +
+                             (size_t)world->contact_capacity *
+                                 sizeof(sl_contact_constraint));
+}
+
+static void study_init(sl_world_state *world)
+{
+    study_context *study = study_get(world);
+    unsigned char *base = (unsigned char *)study + study_align(sizeof(*study));
+    const size_t bodies =
+        study_align((size_t)world->body_capacity * sizeof(uint32_t));
+    const size_t contacts =
+        study_align((size_t)world->contact_capacity * sizeof(uint32_t));
+    study->heads = (uint32_t *)base;
+    base += bodies;
+    study->indegrees = (uint32_t *)base;
+    base += bodies;
+    study->layers = (uint32_t *)base;
+    base += bodies;
+    study->queue = (uint32_t *)base;
+    base += bodies;
+    study->next = (uint32_t *)base;
+    base += contacts;
+    study->order = (uint32_t *)base;
+}
+
+static bool study_dynamic(const sl_world_state *world, uint32_t slot)
+{
+    const uint32_t dense = world->slots[slot].dense;
+    return dense != SL_BODY_DENSE_NONE &&
+           world->types[dense] == (uint8_t)SL_BODY_DYNAMIC;
+}
+
+static double study_height(const sl_world_state *world, uint32_t slot)
+{
+    const sl_vec2 position = world->positions[world->slots[slot].dense];
+    return -(double)world->gravity.x * (double)position.x -
+           (double)world->gravity.y * (double)position.y;
+}
+
+static void study_endpoints(const sl_world_state *world, uint32_t index,
+                            uint32_t *lower, uint32_t *upper)
+{
+    const sl_contact *contact = &world->contacts[world->island_contacts[index]];
+    const uint32_t a = contact->body_a.index, b = contact->body_b.index;
+    const bool a_lower = study_height(world, a) < study_height(world, b);
+    *lower = a_lower ? a : b;
+    *upper = a_lower ? b : a;
+}
+
+static void study_push(uint32_t *queue, uint32_t *count, uint32_t slot)
+{
+    uint32_t at = (*count)++;
+    while (at > 0u) {
+        const uint32_t parent = (at - 1u) / 2u;
+        if (queue[parent] <= slot) {
+            break;
+        }
+        queue[at] = queue[parent];
+        at = parent;
+    }
+    queue[at] = slot;
+}
+
+static uint32_t study_pop(uint32_t *queue, uint32_t *count)
+{
+    const uint32_t result = queue[0], value = queue[--*count];
+    uint32_t at = 0u;
+    while (at < *count / 2u) {
+        uint32_t child = 2u * at + 1u;
+        if (child + 1u < *count && queue[child + 1u] < queue[child]) {
+            ++child;
+        }
+        if (value <= queue[child]) {
+            break;
+        }
+        queue[at] = queue[child];
+        at = child;
+    }
+    if (*count > 0u) {
+        queue[at] = value;
+    }
+    return result;
+}
+
+static bool study_less(const study_context *study, uint32_t a, uint32_t b)
+{
+    return study->next[a] < study->next[b] ||
+           (study->next[a] == study->next[b] && a < b);
+}
+
+static void study_sift(study_context *study, uint32_t *order, uint32_t count,
+                       uint32_t root)
+{
+    while (root < count / 2u) {
+        uint32_t child = 2u * root + 1u;
+        if (child + 1u < count &&
+            study_less(study, order[child], order[child + 1u])) {
+            ++child;
+        }
+        if (!study_less(study, order[root], order[child])) {
+            break;
+        }
+        const uint32_t swap = order[root];
+        order[root] = order[child];
+        order[child] = swap;
+        root = child;
+    }
+}
+
+static void study_build(sl_world_state *world)
+{
+    study_context *study = study_get(world);
+    uint64_t bodies = 0u, contacts = 0u;
+    for (uint32_t slot = 0u; slot < world->body_capacity; ++slot) {
+        study->heads[slot] = UINT32_MAX;
+        study->indegrees[slot] = 0u;
+        study->layers[slot] = 0u;
+        ++bodies;
+    }
+    for (uint32_t index = 0u; index < world->island_contact_count; ++index) {
+        uint32_t lower, upper;
+        study_endpoints(world, index, &lower, &upper);
+        study->order[index] = index;
+        study->next[index] = UINT32_MAX;
+        ++contacts;
+        if (!study_dynamic(world, upper) ||
+            study_height(world, lower) == study_height(world, upper)) {
+            continue;
+        }
+        if (study_dynamic(world, lower)) {
+            study->next[index] = study->heads[lower];
+            study->heads[lower] = index;
+            ++study->indegrees[upper];
+        } else if (world->types[world->slots[lower].dense] ==
+                   (uint8_t)SL_BODY_STATIC) {
+            study->layers[upper] = 1u;
+        }
+    }
+    uint32_t count = 0u;
+    for (uint32_t slot = 0u; slot < world->body_capacity; ++slot) {
+        ++bodies;
+        if (study_dynamic(world, slot) && study->indegrees[slot] == 0u) {
+            study_push(study->queue, &count, slot);
+        }
+    }
+    for (uint32_t visited = 0u; count > 0u && visited < world->body_capacity;
+         ++visited) {
+        const uint32_t slot = study_pop(study->queue, &count);
+        ++bodies;
+        uint32_t edge = study->heads[slot];
+        for (uint32_t n = 0u; edge != UINT32_MAX && n < world->contact_capacity;
+             ++n) {
+            uint32_t lower, upper;
+            study_endpoints(world, edge, &lower, &upper);
+            SL_ASSERT(lower == slot);
+            ++contacts;
+            if (study->layers[lower] > 0u &&
+                study->layers[upper] <= study->layers[lower]) {
+                study->layers[upper] = study->layers[lower] + 1u;
+            }
+            SL_ASSERT(study->indegrees[upper] > 0u);
+            if (--study->indegrees[upper] == 0u) {
+                study_push(study->queue, &count, upper);
+            }
+            edge = study->next[edge];
+        }
+    }
+    for (uint32_t id = 0u; id < world->island_count; ++id) {
+        const sl_island *island = &world->islands[id];
+        uint32_t reason = world->gravity.x == 0.0f && world->gravity.y == 0.0f
+                              ? STUDY_ZERO_GRAVITY
+                              : 0u;
+        if (island->joint_count > 0u) {
+            reason |= STUDY_JOINT;
+        }
+        for (uint32_t i = 0u; i < island->body_count; ++i) {
+            const uint32_t slot = world->island_bodies[island->body_offset + i];
+            ++bodies;
+            if (study->layers[slot] == 0u) {
+                reason |= STUDY_UNROOTED;
+            }
+            if (study->indegrees[slot] > 0u) {
+                reason |= STUDY_CYCLE;
+            }
+        }
+        for (uint32_t i = 0u; i < island->contact_count; ++i) {
+            const uint32_t index = island->contact_offset + i;
+            uint32_t lower, upper;
+            study_endpoints(world, index, &lower, &upper);
+            ++contacts;
+            if (study_height(world, lower) == study_height(world, upper)) {
+                reason |= STUDY_EQUAL_HEIGHT;
+            }
+            if (world->types[world->slots[lower].dense] ==
+                    (uint8_t)SL_BODY_KINEMATIC ||
+                world->types[world->slots[upper].dense] ==
+                    (uint8_t)SL_BODY_KINEMATIC) {
+                reason |= STUDY_KINEMATIC;
+            }
+            if (!study_dynamic(world, upper)) {
+                reason |= STUDY_UNROOTED;
+            }
+            study->next[index] = study->layers[upper];
+        }
+        study->queue[id] = reason;
+        if (reason == 0u) {
+            study->ordered_island_steps =
+                sl_stats_sum(study->ordered_island_steps, 1u);
+            uint32_t *order = study->order + island->contact_offset;
+            for (uint32_t i = island->contact_count / 2u; i > 0u; --i) {
+                study_sift(study, order, island->contact_count, i - 1u);
+            }
+            for (uint32_t i = island->contact_count; i > 1u; --i) {
+                const uint32_t swap = order[0];
+                order[0] = order[i - 1u];
+                order[i - 1u] = swap;
+                study_sift(study, order, i - 1u, 0u);
+            }
+        } else {
+            for (uint32_t bit = 0u; bit < 6u; ++bit) {
+                if ((reason & (1u << bit)) != 0u) {
+                    study->fallback_island_steps[bit] =
+                        sl_stats_sum(study->fallback_island_steps[bit], 1u);
+                }
+            }
+        }
+    }
+    study->graph_body_visits = sl_stats_sum(study->graph_body_visits, bodies);
+    study->graph_contact_visits =
+        sl_stats_sum(study->graph_contact_visits, contacts);
+}
+#endif
