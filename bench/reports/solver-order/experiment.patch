+#if SL_STUDY_TWO_PASS
+bool sl_study_test_rollback(sl_world_state *world)
+{
+    study_context *study = study_get(world);
+    if (world->island_count != 1u || world->islands[0].contact_count < 2u ||
+        study->queue[0] != 0u) {
+        return false;
+    }
+    const sl_island *island = &world->islands[0];
+    uint32_t lower, upper;
+    study_endpoints(
+        world,
+        study->order[island->contact_offset + island->contact_count - 1u],
+        &lower, &upper);
+    const uint32_t row = world->slots[upper].dense;
+    const float inverse_mass = world->inv_masses[row];
+    const float inverse_inertia = world->inv_inertias[row];
+    /* A finite, unsolvable final contact forces failure after earlier work.
+     * This is private fault injection, not a supported public body state. */
+    world->inv_masses[row] = 0.0f;
+    world->inv_inertias[row] = 0.0f;
+    const uint64_t evaluations = study->constraint_evaluations;
+    const uint64_t rollbacks = study->rollbacks;
+    bool restored = !study_two_pass(world, 0u, 240.0f);
+    restored = restored && study->constraint_evaluations > evaluations &&
+               study->rollbacks == rollbacks + 1u &&
+               world->inv_masses[row] == 0.0f &&
+               world->inv_inertias[row] == 0.0f;
+    restored =
+        restored && memcmp(world_constraints(world) + island->contact_offset,
+                           study->saved_constraints + island->contact_offset,
+                           (size_t)island->contact_count *
+                               sizeof(sl_contact_constraint)) == 0;
+    for (uint32_t i = 0u; i < island->body_count; ++i) {
+        const uint32_t dense =
+            world->slots[world->island_bodies[island->body_offset + i]].dense;
+        restored = restored &&
+                   memcmp(&world->velocities[dense],
+                          &study->saved_linear[dense], sizeof(sl_vec2)) == 0 &&
+                   memcmp(&world->angular_velocities[dense],
+                          &study->saved_angular[dense], sizeof(float)) == 0;
+    }
+    world->inv_masses[row] = inverse_mass;
+    world->inv_inertias[row] = inverse_inertia;
+    return restored;
+}
+#endif
