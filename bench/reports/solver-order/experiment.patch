+static bool study_two_pass(sl_world_state *world, uint32_t id, float inverse_h)
+{
+    study_context *study = study_get(world);
+    const sl_island *island = &world->islands[id];
+    sl_contact_constraint *constraints = world_constraints(world);
+    memcpy(study->saved_constraints + island->contact_offset,
+           constraints + island->contact_offset,
+           (size_t)island->contact_count * sizeof(*constraints));
+    for (uint32_t i = 0u; i < island->body_count; ++i) {
+        const uint32_t row =
+            world->slots[world->island_bodies[island->body_offset + i]].dense;
+        study->saved_linear[row] = world->velocities[row];
+        study->saved_angular[row] = world->angular_velocities[row];
+        study->pending_linear[row] = sl_vec2_make(0.0f, 0.0f);
+        study->pending_angular[row] = 0.0f;
+    }
+    bool valid = true;
+    const uint32_t *order = study->order + island->contact_offset;
+    for (uint32_t i = 0u; valid && i < island->contact_count; ++i) {
+        valid = study_upper_solve(world, order[i], inverse_h);
+    }
+    uint32_t end = island->contact_count;
+    for (uint32_t pass = 0u; valid && end > 0u && pass < island->contact_count;
+         ++pass) {
+        const uint32_t layer = study->next[order[end - 1u]];
+        uint32_t begin = end - 1u;
+        while (begin > 0u && study->next[order[begin - 1u]] == layer) {
+            --begin;
+        }
+        for (uint32_t i = 0u; valid && i < island->body_count; ++i) {
+            const uint32_t slot = world->island_bodies[island->body_offset + i];
+            if (study->layers[slot] != layer) {
+                continue;
+            }
+            const uint32_t row = world->slots[slot].dense;
+            const sl_vec2 velocity =
+                sl_vec2_add(world->velocities[row], study->pending_linear[row]);
+            const float angular =
+                world->angular_velocities[row] + study->pending_angular[row];
+            valid = sl_vec2_is_finite(velocity) && sl_is_finite(angular);
+            if (valid) {
+                world->velocities[row] = velocity;
+                world->angular_velocities[row] = angular;
+                study->pending_linear[row] = sl_vec2_make(0.0f, 0.0f);
+                study->pending_angular[row] = 0.0f;
+            }
+        }
+        for (uint32_t i = begin; valid && i < end; ++i) {
+            valid = study_upper_solve(world, order[i], inverse_h);
+        }
+        end = begin;
+    }
+    if (valid) {
+        return true;
+    }
+    /* Roll back the complete attempted stage, then let the caller run Soft
+     * Step. */
+    study->rollbacks = sl_stats_sum(study->rollbacks, 1u);
+    memcpy(constraints + island->contact_offset,
+           study->saved_constraints + island->contact_offset,
+           (size_t)island->contact_count * sizeof(*constraints));
+    for (uint32_t i = 0u; i < island->body_count; ++i) {
+        const uint32_t row =
+            world->slots[world->island_bodies[island->body_offset + i]].dense;
+        world->velocities[row] = study->saved_linear[row];
+        world->angular_velocities[row] = study->saved_angular[row];
+    }
+    return false;
+}
+#endif
