diff --git a/tests/test_study_graph.c b/tests/test_study_graph.c
new file mode 100644
--- /dev/null
+++ b/tests/test_study_graph.c
@@ -0,0 +1,163 @@
+#include "silk_test.h"
+#include "solver.h"
+#include "study_test.h"
+#include "suites.h"
+#include <silk/step.h>
+
+static sl_body_handle add(sl_world *world, sl_body_type type, float x, float y)
+{
+    sl_shape shape = sl_shape_none();
+    SL_EXPECT(sl_shape_make_box(0.5f, 0.5f, &shape));
+    const sl_body_desc desc = { .type = type,
+                                .mass = type == SL_BODY_DYNAMIC ? 1.0f : 0.0f,
+                                .position = { x, y },
+                                .shape = &shape,
+                                .friction = 0.6f };
+    const sl_body_handle body = sl_world_body_create(world, &desc);
+    SL_EXPECT(!sl_body_handle_is_null(body));
+    return body;
+}
+
+/* Repeated edge relaxation is independent of the candidate's adjacency,
+ * topological heap and contact permutation. Read the public contact snapshot.
+ */
+static void check_layers(sl_world *world)
+{
+    enum { CAPACITY = 16 };
+    uint32_t expected[CAPACITY] = { 0 };
+    sl_solver_prepare(world->state, 1.0f / 240.0f, 240.0f);
+    for (uint32_t pass = 0u; pass < CAPACITY; ++pass) {
+        for (uint32_t i = 0u; i < sl_world_contact_count(world); ++i) {
+            const sl_contact *contact = sl_world_contact_at(world, i);
+            if (contact->manifold.point_count == 0u) {
+                continue;
+            }
+            sl_body_handle a = contact->body_a, b = contact->body_b;
+            const sl_vec2 pa = sl_world_body_get_position(world, a);
+            const sl_vec2 pb = sl_world_body_get_position(world, b);
+            if (pa.y == pb.y) {
+                continue;
+            }
+            if (pa.y > pb.y) {
+                const sl_body_handle swap = a;
+                a = b;
+                b = swap;
+            }
+            if (sl_world_body_get_type(world, b) != SL_BODY_DYNAMIC) {
+                continue;
+            }
+            uint32_t layer = 0u;
+            if (sl_world_body_get_type(world, a) == SL_BODY_STATIC) {
+                layer = 1u;
+            } else if (sl_world_body_get_type(world, a) == SL_BODY_DYNAMIC &&
+                       expected[a.index] > 0u) {
+                layer = expected[a.index] + 1u;
+            }
+            if (layer > expected[b.index]) {
+                expected[b.index] = layer;
+            }
+        }
+    }
+    for (uint32_t slot = 0u; slot < CAPACITY; ++slot) {
+        SL_EXPECT_INT_EQ(sl_study_test_layer(world->state, slot),
+                         expected[slot]);
+    }
+}
+
+static void seeded_layer_oracle(void)
+{
+    const sl_world_config config = { .body_capacity = 16u,
+                                     .contact_capacity = 64u,
+                                     .gravity = { 0.0f, -10.0f } };
+    sl_world world = { 0 };
+    SL_EXPECT(sl_world_init(&world, &config));
+    uint32_t seed = 0x9164a75bu;
+    for (uint32_t iteration = 0u; iteration < 64u; ++iteration) {
+        sl_world_reset(&world);
+        (void)add(&world, SL_BODY_STATIC, 0.0f, -0.5f);
+        sl_body_handle bodies[6];
+        for (uint32_t i = 0u; i < 6u; ++i) {
+            seed = seed * 1664525u + 1013904223u;
+            bodies[i] =
+                add(&world, SL_BODY_DYNAMIC, (seed >> 31u) != 0u ? 0.0f : 0.25f,
+                    0.5f + (float)i);
+        }
+        sl_world_step(&world, 1.0f / 60.0f);
+        check_layers(&world);
+        const uint32_t slot = iteration % 6u;
+        sl_world_body_destroy(&world, bodies[slot]);
+        bodies[slot] = add(&world, SL_BODY_DYNAMIC, 4.0f, 2.0f);
+        SL_EXPECT(sl_world_body_set_position(&world, bodies[(slot + 1u) % 6u],
+                                             sl_vec2_make(0.0f, 8.0f)));
+        sl_world_step(&world, 1.0f / 60.0f);
+        check_layers(&world);
+    }
+    sl_world_destroy(&world);
+}
+
+static void fallback_policies(void)
+{
+    for (uint32_t variant = 0u; variant < 5u; ++variant) {
+        const sl_world_config config = {
+            .body_capacity = 16u,
+            .contact_capacity = 64u,
+            .joint_capacity = 1u,
+            .gravity = { 0.0f, variant == 0u ? 0.0f : -10.0f }
+        };
+        sl_world world = { 0 };
+        SL_EXPECT(sl_world_init(&world, &config));
+        const sl_body_handle support =
+            add(&world, variant == 2u ? SL_BODY_KINEMATIC : SL_BODY_STATIC,
+                0.0f, -0.5f);
+        const sl_body_handle body =
+            add(&world, SL_BODY_DYNAMIC, 0.0f, variant == 4u ? 5.0f : 0.5f);
+        if (variant == 1u) {
+            const sl_joint_desc joint = { .body_a = support,
+                                          .body_b = body,
+                                          .kind = SL_JOINT_DISTANCE,
+                                          .distance = { .length = 1.0f },
+                                          .collide_connected = true };
+            SL_EXPECT(!sl_joint_handle_is_null(
+                sl_world_joint_create(&world, &joint)));
+        }
+        if (variant == 3u) {
+            (void)add(&world, SL_BODY_DYNAMIC, 0.999f, 0.5f);
+        }
+        sl_world_step(&world, 1.0f / 60.0f);
+        const uint32_t id = world.state->body_islands[body.index];
+        SL_EXPECT((sl_study_test_fallback(world.state, id) & (1u << variant)) !=
+                  0u);
+        sl_world_destroy(&world);
+    }
+}
+
+#if SL_STUDY_TWO_PASS
+static void stage_rollback(void)
+{
+    const sl_world_config config = { .body_capacity = 16u,
+                                     .contact_capacity = 64u,
+                                     .gravity = { 0.0f, -10.0f } };
+    sl_world world = { 0 };
+    SL_EXPECT(sl_world_init(&world, &config));
+    (void)add(&world, SL_BODY_STATIC, 0.0f, -0.5f);
+    (void)add(&world, SL_BODY_DYNAMIC, 0.0f, 0.49f);
+    (void)add(&world, SL_BODY_DYNAMIC, 0.0f, 1.48f);
+    sl_world_step(&world, 1.0f / 60.0f);
+    SL_EXPECT(sl_study_test_rollback(world.state));
+    sl_world_destroy(&world);
+}
+
+#endif
+
+static const sl_test_case k_cases[] = {
+    { "seeded independent layer oracle", seeded_layer_oracle },
+    { "fallback policies", fallback_policies },
+#if SL_STUDY_TWO_PASS
+    { "finite failed stage rollback", stage_rollback },
+#endif
+};
+int sl_study_graph_suite(void)
+{
+    return sl_run_suite("study graph", k_cases,
+                        (int)(sizeof(k_cases) / sizeof(k_cases[0])));
+}
