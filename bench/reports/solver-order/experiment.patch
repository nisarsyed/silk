+#if SL_STUDY_TWO_PASS
+/* The isolated candidate uses a local prepared manifold with the lower
+ * endpoint's effective response removed. Restore inverse properties before
+ * recording its withheld reaction; no public operation observes the override.
+ */
+static bool study_upper_solve(sl_world_state *world, uint32_t index,
+                              float inverse_h)
+{
+    study_context *study = study_get(world);
+    sl_contact_constraint *original = &world_constraints(world)[index];
+    sl_contact_constraint local = *original;
+    uint32_t lower, upper;
+    study_endpoints(world, index, &lower, &upper);
+    (void)upper;
+    const uint32_t row = world->slots[lower].dense;
+    const float inverse_mass = world->inv_masses[row];
+    const float inverse_inertia = world->inv_inertias[row];
+    world->inv_masses[row] = 0.0f;
+    world->inv_inertias[row] = 0.0f;
+    const sl_vec2 tangent = sl_vec2_right_perp(local.normal);
+    bool valid = true;
+    for (uint32_t p = 0u; p < local.point_count; ++p) {
+        sl_contact_constraint_point *point = &local.points[p];
+        point->normal_mass =
+            effective_mass(world, local.dense_a, local.dense_b, point->anchor_a,
+                           point->anchor_b, local.normal);
+        point->tangent_mass =
+            effective_mass(world, local.dense_a, local.dense_b, point->anchor_a,
+                           point->anchor_b, tangent);
+        valid =
+            valid && point->normal_mass > 0.0f && point->tangent_mass > 0.0f;
+    }
+    if (local.point_count == 2u) {
+        local.normal_coupling = effective_mass_coupling(
+            world, local.dense_a, local.dense_b, local.points[0].anchor_a,
+            local.points[0].anchor_b, local.points[1].anchor_a,
+            local.points[1].anchor_b, local.normal);
+    }
+    if (valid) {
+        study->constraint_evaluations =
+            sl_stats_sum(study->constraint_evaluations, 1u);
+        constraint_solve(world, &local, inverse_h, true);
+    }
+    world->inv_masses[row] = inverse_mass;
+    world->inv_inertias[row] = inverse_inertia;
+    if (!valid) {
+        return false;
+    }
+    /* Static rows can have belonged to a dynamic body before packed reuse.
+     * They never receive deferred reactions, so do not read their scratch. */
+    const bool dynamic = study_dynamic(world, lower);
+    sl_vec2 pending =
+        dynamic ? study->pending_linear[row] : sl_vec2_make(0.0f, 0.0f);
+    float angular = dynamic ? study->pending_angular[row] : 0.0f;
+    for (uint32_t p = 0u; p < local.point_count; ++p) {
+        const sl_contact_constraint_point *point = &local.points[p];
+        const sl_contact_constraint_point *before = &original->points[p];
+        sl_vec2 impulse =
+            sl_vec2_add(sl_vec2_scale(local.normal, point->normal_impulse -
+                                                        before->normal_impulse),
+                        sl_vec2_scale(tangent, point->tangent_impulse -
+                                                   before->tangent_impulse));
+        const bool lower_a = row == local.dense_a;
+        if (lower_a) {
+            impulse = sl_vec2_neg(impulse);
+        }
+        const sl_vec2 anchor = lower_a ? point->anchor_a : point->anchor_b;
+        pending = sl_vec2_add(pending, sl_vec2_scale(impulse, inverse_mass));
+        angular += inverse_inertia * sl_vec2_cross(anchor, impulse);
+    }
+    if (!sl_vec2_is_finite(pending) || !sl_is_finite(angular) ||
+        !sl_vec2_is_finite(sl_vec2_add(world->velocities[row], pending)) ||
+        !sl_is_finite(world->angular_velocities[row] + angular)) {
+        return false;
+    }
+    study->pending_linear[row] = pending;
+    study->pending_angular[row] = angular;
+    for (uint32_t p = 0u; p < local.point_count; ++p) {
+        original->points[p].normal_impulse = local.points[p].normal_impulse;
+        original->points[p].tangent_impulse = local.points[p].tangent_impulse;
+        original->points[p].max_normal_impulse =
+            local.points[p].max_normal_impulse;
+    }
+    return true;
+}
