+sl_study_stats sl_world_study_stats_get(const sl_world *owner)
+{
+    sl_study_stats out = { 0 };
+    if (owner == NULL || owner->state == NULL) {
+        return out;
+    }
+    const sl_world_state *world = owner->state;
+    const study_context *study = study_get(world);
+    out.graph_body_visits = study->graph_body_visits;
+    out.graph_contact_visits = study->graph_contact_visits;
+    out.constraint_evaluations = study->constraint_evaluations;
+    out.ordered_island_steps = study->ordered_island_steps;
+    for (uint32_t i = 0u; i < 6u; ++i) {
+        out.fallback_island_steps[i] = study->fallback_island_steps[i];
+    }
+    out.extra_bytes =
+        study_memory_bytes(world->body_capacity, world->contact_capacity);
+    return out;
