{
    "version": 6,
    "configurePresets": [
        {
            "name": "debug",
            "displayName": "Debug",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "sanitize",
            "displayName": "Sanitizers (ASan + UBSan)",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/sanitize",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SL_SANITIZERS": "ON"
            }
        },
        {
            "name": "windows",
            "displayName": "Windows (MSVC)",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/windows"
        },
        {
            "name": "sandbox",
            "displayName": "Raylib Sandbox",
            "inherits": "debug",
            "binaryDir": "${sourceDir}/build/sandbox",
            "cacheVariables": {
                "SL_SANDBOX": "ON"
            }
        },
        {
            "name": "sandbox-release",
            "displayName": "Raylib Sandbox (Release)",
            "inherits": "release",
            "binaryDir": "${sourceDir}/build/sandbox-release",
            "cacheVariables": {
                "SL_SANDBOX": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "sanitize",
            "configurePreset": "sanitize"
        },
        {
            "name": "windows",
            "configurePreset": "windows",
            "configuration": "Debug"
        },
        {
            "name": "sandbox",
            "configurePreset": "sandbox"
        },
        {
            "name": "sandbox-release",
            "configurePreset": "sandbox-release"
        }
    ],
    "testPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "release",
            "configurePreset": "release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "sanitize",
            "configurePreset": "sanitize",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows",
            "configurePreset": "windows",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "sandbox",
            "configurePreset": "sandbox",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "sandbox-release",
            "configurePreset": "sandbox-release",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
